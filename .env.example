# ==============================================================================
# AgentPay Global Environment Configuration Template
# ==============================================================================

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
PAYMENT_MODE=simulation
API_KEYS={}
ADMIN_USER_IDS=[]
SERVICE_ORIGINS=[]
SEED_DEMO_DATA=true
# For Docker Compose, set this to a generated URL-safe credential before launch.
AGENTPAY_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentpay
# Fallback to local SQLite if PostgreSQL is not running
# DATABASE_URL=sqlite+aiosqlite:///./agentpay.db

# LLM Provider Configuration
# Reserved configuration: the current planner is deterministic, not an LLM.
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-2.0-flash

# Blockchain / Web3 Configuration
EVM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
CHAIN_ID=421614
AGENTPAY_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
MOCK_USDC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
PAYMENT_MANAGER_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
AGENT_RELAYER_PRIVATE_KEY=

# Default Policy Engine Limits (in USD / USDC)
DEFAULT_MAX_TRANSACTION=0.10
DEFAULT_DAILY_LIMIT=2.00
DEFAULT_MONTHLY_LIMIT=20.00
AUTO_PAYMENT_ENABLED=true

# Frontend Configuration
VITE_API_URL=http://localhost:8000
